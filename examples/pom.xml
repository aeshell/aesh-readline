<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.aesh</groupId>
        <artifactId>readline-all</artifactId>
        <version>3.19.1-dev</version>
    </parent>

    <artifactId>examples</artifactId>
    <packaging>jar</packaging>
    <name>Aesh Readline Examples</name>
    <description>Example applications for Aesh Readline and Terminal API</description>

    <dependencies>
        <dependency>
            <groupId>org.aesh</groupId>
            <artifactId>terminal-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.aesh</groupId>
            <artifactId>terminal-detect</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.aesh</groupId>
            <artifactId>terminal-tty</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.aesh</groupId>
            <artifactId>readline</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Skip formatting for examples module -->
            <plugin>
                <groupId>net.revelc.code.formatter</groupId>
                <artifactId>formatter-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>net.revelc.code</groupId>
                <artifactId>impsort-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Build a native image of an example application:
             mvn -Pexamples,native -DskipTests -Dformat.skip=true -pl examples -am package
             (both profiles: the examples module itself is profile-gated).
             Override the entry point with -Dexample.main=... for the other
             examples. Needs GraalVM 25 on PATH. The jars' shipped
             META-INF/native-image metadata is picked up automatically. -->
        <profile>
            <id>native</id>
            <properties>
                <example.main>org.aesh.terminal.tty.example.TerminalColorExample</example.main>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>1.1.18</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-example-image</id>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>${example.main}</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
